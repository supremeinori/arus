# ==============================================================================
# ARUS Workspace Environment Configuration Example
# File contoh konfigurasi environment untuk proyek ARUS (Backend API & Flutter App)
# ==============================================================================

# ==============================================================================
# [A] BACKEND API (Express.js + Prisma)
# Salin konfigurasi ini ke file: api/.env
# ==============================================================================

# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Pilihan 1: Docker PostgreSQL Lokal
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arus_db?schema=public"

# Pilihan 2: Supabase Cloud PostgreSQL (Online Mode)
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# Autentikasi JWT
JWT_ACCESS_SECRET="arus_jwt_secret_dev_key_super_secure_32_chars_min"
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7

# AI Assistant & DSS (Google Gemini)
LLM_PROVIDER=gemini
# Dapatkan API Key di: https://aistudio.google.com/
LLM_API_KEY="your_google_gemini_api_key_here"
LLM_MODEL=gemini-3.5-flash-lite
AI_RATE_PER_MIN=10
AI_RATE_PER_DAY=100

# Kurs / Foreign Exchange API
FX_API_URL="https://api.frankfurter.dev/v1/latest"

# Feature Flags
FEATURE_INTEGRITY=true
FEATURE_NOTIFICATIONS=true
FEATURE_FX=true
FEATURE_GAME=true
FEATURE_AI=true

# Firebase Cloud Messaging (push notification) — OPSIONAL.
# Biarkan kosong bila push belum dikonfigurasi: backend tetap berjalan normal,
# hanya pengiriman push yang dilewati (tidak ada error).
# Ambil dari Firebase Console > Project Settings > Service Accounts > Generate New Private Key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""


# ==============================================================================
# [B] FRONTEND FLUTTER APP
# Konfigurasi runtime Flutter dapat dilewatkan via argument --dart-define:
#   flutter run --dart-define=API_BASE_URL=http://localhost:5000/api --dart-define=APP_ENV=dev
# ==============================================================================

# URL API Backend untuk Flutter:
# - Web & Desktop (Windows/macOS): http://localhost:5000/api
# - Android Emulator: http://10.0.2.2:5000/api
# - Device Fisik (Wi-Fi Lokal): http://<IP_KOMPUTER_ANDA>:5000/api (misal: http://192.168.1.50:5000/api)
# - Production Cloud: https://api.yourdomain.com/api
API_BASE_URL="http://localhost:5000/api"
APP_ENV="dev"

# Opsi Firebase untuk Android bila memakai --dart-define (alternatif google-services.json).
# Diperlukan hanya jika android/app/google-services.json tidak tersedia:
#   flutter run --dart-define=FIREBASE_API_KEY=... --dart-define=FIREBASE_APP_ID=... \
#               --dart-define=FIREBASE_PROJECT_ID=... --dart-define=FIREBASE_MESSAGING_SENDER_ID=...
# FIREBASE_API_KEY=""
# FIREBASE_APP_ID=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_MESSAGING_SENDER_ID=""
