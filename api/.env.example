# ==============================================================================
# ARUS Backend Environment Configuration Example
# Salin file ini menjadi `.env` di folder `api/` lalu sesuaikan isinya:
#   cp .env.example .env (Linux/macOS) atau copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Pilihan A: Docker PostgreSQL Lokal
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arus_db?schema=public"

# Pilihan B: Supabase Cloud PostgreSQL (Rekomendasi untuk deployment online)
# Format Transaction Pooler (port 6543) dengan pgbouncer:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# Format Direct Connection (port 5432) untuk migrasi:
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Minimal 32 karakter acak yang aman untuk signing JWT
JWT_ACCESS_SECRET="arus_jwt_secret_dev_key_super_secure_32_chars_min"
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7

# ------------------------------------------------------------------------------
# 4. AI Assistant & Decision Support System (Google Gemini)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Dapatkan API key gratis dari Google AI Studio: https://aistudio.google.com/
LLM_API_KEY="your_google_gemini_api_key_here"

# Model yang aktif dan terverifikasi di ekosistem ARUS:
# - gemini-3.5-flash-lite (Rekomendasi: cepat, hemat token, responsif)
# - gemini-3.8-flash
LLM_MODEL=gemini-3.5-flash-lite

# Batasan rate limit panggilan AI
AI_RATE_PER_MIN=10
AI_RATE_PER_DAY=100

# ------------------------------------------------------------------------------
# 5. External APIs (Foreign Exchange / Kurs)
# ------------------------------------------------------------------------------
FX_API_URL="https://api.frankfurter.dev/v1/latest"

# ------------------------------------------------------------------------------
# 6. Feature Flags (Aktivasi / Deaktivasi Modul)
# ------------------------------------------------------------------------------
FEATURE_INTEGRITY=true
FEATURE_NOTIFICATIONS=true
FEATURE_FX=true
FEATURE_GAME=true
FEATURE_AI=true
