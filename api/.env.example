# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arus_db?schema=public

# Authentication
JWT_ACCESS_SECRET=arus_jwt_secret_dev_key_super_secure_32_chars_min
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7

# AI Assistant
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash
AI_RATE_PER_MIN=10
AI_RATE_PER_DAY=100

# External APIs
FX_API_URL=https://api.frankfurter.dev/v1/latest

# Feature Flags (Core vs Optional per SRS Section 23.3)
FEATURE_INTEGRITY=true
FEATURE_NOTIFICATIONS=true
FEATURE_FX=true
FEATURE_GAME=true
FEATURE_AI=true
